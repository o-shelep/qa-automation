{
  "info": {
    "_postman_id": "00000000-0000-0000-0000-0000000005a5",
    "name": "Orders API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Показовий приклад",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob@example.com\",\n  \"password\": \"Secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"sku\": \"SKU-A\",\n      \"price\": 500,\n      \"qty\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 201', () => pm.response.to.have.status(201));",
                  "pm.test('сума з доставкою', () => {",
                  "  pm.expect(pm.response.json().total).to.eql(560);",
                  "});",
                  "pm.collectionVariables.set('orderId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('те саме замовлення', () => {",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('orderId'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Варіант 9 — Idempotency-Key",
      "item": [
        {
          "name": "List orders (before)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 200', () => pm.response.to.have.status(200));",
                  "// сервер живе між прогонами, тому фіксуємо кількість «до», а не очікуємо абсолютне число",
                  "pm.collectionVariables.set('countBefore', pm.response.json().length);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create order with Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"sku\": \"SKU-A\",\n      \"price\": 500,\n      \"qty\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// новий ключ на кожен прогін колекції",
                  "pm.collectionVariables.set('idemKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 201', () => pm.response.to.have.status(201));",
                  "pm.test('перший запит не є повтором', () => {",
                  "  pm.response.to.have.header('Idempotent-Replayed', 'false');",
                  "});",
                  "pm.test('Location вказує на створене замовлення', () => {",
                  "  pm.response.to.have.header('Location', '/orders/' + pm.response.json().id);",
                  "});",
                  "pm.test('ownerId не потрапляє у відповідь', () => {",
                  "  pm.expect(pm.response.json()).to.not.have.property('ownerId');",
                  "});",
                  "pm.collectionVariables.set('idemOrderId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Repeat with same Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"sku\": \"SKU-A\",\n      \"price\": 500,\n      \"qty\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 201, як у першої відповіді', () => pm.response.to.have.status(201));",
                  "pm.test('позначено як повтор', () => {",
                  "  pm.response.to.have.header('Idempotent-Replayed', 'true');",
                  "});",
                  "pm.test('повернуто те саме замовлення', () => {",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('idemOrderId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Same key, different body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"sku\": \"SKU-B\",\n      \"price\": 900,\n      \"qty\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 422', () => pm.response.to.have.status(422));",
                  "pm.test('код IDEMPOTENCY_KEY_REUSED', () => {",
                  "  pm.expect(pm.response.json()).to.eql({ code: 'IDEMPOTENCY_KEY_REUSED' });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "bad key"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"sku\": \"SKU-A\",\n      \"price\": 500,\n      \"qty\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 400', () => pm.response.to.have.status(400));",
                  "pm.test('код INVALID_IDEMPOTENCY_KEY', () => {",
                  "  pm.expect(pm.response.json().code).to.eql('INVALID_IDEMPOTENCY_KEY');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List orders (side effect)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 200', () => pm.response.to.have.status(200));",
                  "pm.test('замовлення з ключем створено рівно один раз', () => {",
                  "  const id = pm.collectionVariables.get('idemOrderId');",
                  "  const same = pm.response.json().filter((o) => o.id === id);",
                  "  pm.expect(same).to.have.lengthOf(1);",
                  "});",
                  "pm.test('додано рівно одне замовлення, хоча POST з ключем надіслано тричі', () => {",
                  "  const before = Number(pm.collectionVariables.get('countBefore'));",
                  "  pm.expect(pm.response.json()).to.have.lengthOf(before + 1);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "idemKey",
      "value": ""
    },
    {
      "key": "idemOrderId",
      "value": ""
    },
    {
      "key": "countBefore",
      "value": ""
    }
  ]
}